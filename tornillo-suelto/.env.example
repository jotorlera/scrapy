# TORNILLO SUELTO · motor ATLAS — copiar a .env y rellenar. Nunca subir .env al repositorio.

# Activa la mesa de agentes (extractor, editor, filósofo, tutor, equipo rojo, superpronosticador).
# Sin ella, todo el núcleo determinista funciona igual (ADR-0004).
ANTHROPIC_API_KEY=

# Datos macro (gratuita, opcional). Sin ella, ECONOMÍA muestra solo lo que llega por comunicados y mercados.
FRED_API_KEY=

# Identificación del crawler (buena práctica para los medios)
ATLAS_USER_AGENT="TORNILLO-SUELTO/0.1 (ATLAS personal research crawler; contact: TODO@example.com)"

# Embeddings: hashing (por defecto, sin descargas) o bge-m3 (requiere `pip install -e ".[embeddings]"`, ~2,3 GB)
ATLAS_EMBEDDINGS=hashing

# Servidor
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8765
ATLAS_SCHEDULER=1
ATLAS_INGEST_CONCURRENCY=12
ATLAS_TIMEZONE=Europe/Monaco
